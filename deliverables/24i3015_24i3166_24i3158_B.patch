+
+	ld.lpos().dist_bottom = 2.5f;
+	ld._get_ground_contact_state();
+	EXPECT_FALSE(ld._get_ground_effect_state());
+
+	ld.lpos().dist_bottom = 2.f; // boundary: exactly LNDMC_ALT_GND is not "below" (strict "<")
