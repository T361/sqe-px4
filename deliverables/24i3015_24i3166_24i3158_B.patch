+	esc_status_s esc{};
+	esc.timestamp = hrt_absolute_time();
+	esc.esc_count = 1;
+	esc.esc[0].actuator_function = actuator_motors_s::ACTUATOR_FUNCTION_MOTOR1;
+	esc.esc[0].timestamp = esc.timestamp;
