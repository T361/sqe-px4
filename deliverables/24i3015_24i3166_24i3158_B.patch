+	ld.forceMaybeLanded(false);
+
+	pubTrajectoryVz(NAN);
+	ld._update_topics();
+	EXPECT_FALSE(ld._get_ground_contact_state());
+	EXPECT_FALSE(ld._get_in_descend());
+
+	pubTrajectoryVz(0.f);
+	ld._update_topics();
+	EXPECT_FALSE(ld._get_ground_contact_state());
+
+	pubTrajectoryVz(0.5f);
+	ld._update_topics();
+	EXPECT_TRUE(ld._get_ground_contact_state());
+	EXPECT_TRUE(ld._get_in_descend());
+}
